# 独立启动被测服务时使用；复制到未跟踪的 .env，填写个人授权配置。
BANK_MODEL_BASE_URL=https://your-provider.example/v1
BANK_MODEL_NAME=your-tool-calling-model
BANK_MODEL_API_KEY=replace-with-your-key

# DeepSeek v4 Pro 示例：BASE_URL=https://api.deepseek.com，NAME=deepseek-v4-pro
# 显式关闭默认思考模式，沿用当前工具调用与 JSON 输出流程；不配置则使用提供方默认。
# BANK_MODEL_THINKING=disabled
